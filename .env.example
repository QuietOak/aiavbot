# Copy this file to ".env" and fill it in.
# Safest place for .env:  %LOCALAPPDATA%\AIAVBOT\.env   (outside Dropbox)
# It also works next to bot.py, but don't do that if this Dropbox folder is shared.

# Bot token from the Discord Developer Portal (Bot tab > Reset Token). Keep it secret.
DISCORD_TOKEN=

# Your TEST server's id (right-click the server icon > Copy Server ID).
# Slash commands appear there instantly. Leave blank for the live server.
DEV_GUILD_ID=

# Optional: where to keep the database. Default: %LOCALAPPDATA%\AIAVBOT\aiavbot.db
# Don't put it in Dropbox; syncing can corrupt it.
DB_PATH=
